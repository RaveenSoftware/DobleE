generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  name      String
  role      String   @default("mesero")
  branchId  String?  // null = superadmin, otherwise links to their Branch
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Branch {
  id            String   @id @default(uuid())
  name          String
  city          String
  ownerName     String
  ownerEmail    String
  phone         String?
  plan          String   @default("Pro Negocio")
  status        String   @default("Activo")
  monthlySales  Float    @default(0)
  ordersMonth   Int      @default(0)
  activeWaiters Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Product {
  id                String   @id @default(uuid())
  branchId          String   // which branch owns this product
  name              String
  category          String
  description       String
  basePrice         Float
  baseCost          Float
  image             String?
  isPopular         Boolean  @default(false)
  isAvailable       Boolean  @default(true)
  flavors           String   // JSON string of arrays
  sizePrices        String?  // JSON string of prices
  allowedToppingIds String?  // JSON array of topping IDs
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model Topping {
  id        String   @id @default(uuid())
  branchId  String   
  name      String
  category  String
  price     Float
  cost      Float
  inStock   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Flavor {
  id        String   @id @default(uuid())
  branchId  String   
  name      String
  category  String
  color     String
  inStock   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Order {
  id             String   @id @default(uuid())
  orderNumber    Int      @default(autoincrement())
  branchId       String   
  customerType   String   @default("guest")
  customerId     String?
  customerName   String?
  customerPhone  String?
  tableName      String?
  tableId        String?
  waiterId       String?
  waiterName     String?
  items          String   @default("[]") // JSON string
  subtotal       Float    @default(0)
  discount       Float    @default(0)
  discountReason String?
  pointsUsed     Int      @default(0)
  pointsEarned   Int      @default(0)
  total          Float    @default(0)
  totalCost      Float    @default(0)
  netProfit      Float    @default(0)
  paymentMethod  String   @default("Efectivo")
  status         String   @default("Pendiente")
  channel        String   @default("Punto de Venta (POS)")
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Staff {
  id          String   @id @default(uuid())
  branchId    String
  name        String
  role        String
  pin         String
  phone       String?
  active      Boolean  @default(true)
  shiftStatus String   @default("fuera")
  totalSales  Float    @default(0)
  totalOrders Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Customer {
  id             String   @id @default(uuid())
  branchId       String
  name           String
  email          String?
  phone          String
  points         Int      @default(0)
  lifetimePoints Int      @default(0)
  totalSpent     Float    @default(0)
  ordersCount    Int      @default(0)
  tier           String   @default("Bronce")
  lastOrderDate  DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Reward {
  id             String   @id @default(uuid())
  branchId       String
  title          String
  description    String
  pointsCost     Int
  discountAmount Float
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model TableItem {
  id             String   @id @default(uuid())
  branchId       String
  name           String
  capacity       Int      @default(4)
  area           String   @default("Salón Principal")
  shape          String   @default("cuadrada")
  status         String   @default("libre")
  isHidden       Boolean  @default(false)
  currentOrderId String?
  orderTotal     Float    @default(0)
  activeWaiter   String?
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model InventoryItem {
  id           String   @id @default(uuid())
  branchId     String
  name         String
  category     String
  unit         String
  currentStock Float
  minStock     Float
  costPerUnit  Float
  lastRestocked DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Expense {
  id          String   @id @default(uuid())
  branchId    String
  category    String
  description String
  amount      Float
  date        DateTime @default(now())
  recordedBy  String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model CashShift {
  id             String   @id @default(uuid())
  branchId       String
  isOpen         Boolean  @default(true)
  openedAt       DateTime @default(now())
  closedAt       DateTime?
  initialAmount  Float
  expectedAmount Float?
  countedAmount  Float?
  difference     Float?
  openedBy       String
  closedBy       String?
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model AuditLog {
  id        String   @id @default(uuid())
  branchId  String?
  userId    String?
  userName  String?
  userEmail String?
  action    String
  entity    String?
  entityId  String?
  details   String?
  ip        String?
  createdAt DateTime @default(now())
}
