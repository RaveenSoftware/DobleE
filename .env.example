# ──────────────────────────────────────────────────────────
# GRANIZADO DOBLEE - Variables de Entorno (Backend)
# ──────────────────────────────────────────────────────────
# Copia este archivo a backend/.env y llena los valores reales.
# NUNCA subas el archivo .env real al repositorio de git.
# ──────────────────────────────────────────────────────────

# ─── DATABASE (PostgreSQL) ───────────────────────────────
# En Coolify: usa la URL que Coolify te genera al crear el servicio PostgreSQL
# Formato: postgresql://USUARIO:CONTRASEÑA@HOST:5432/NOMBRE_DB?schema=public
DATABASE_URL="postgresql://USUARIO:CONTRASEÑA@HOST:5432/doblee?schema=public"

# ─── SEGURIDAD JWT ───────────────────────────────────────
# Cambia esto por una clave aleatoria larga y segura en producción
# Puedes generar una en: https://generate-secret.vercel.app/64
JWT_SECRET="CAMBIA_ESTO_POR_UNA_CLAVE_LARGA_Y_SEGURA"

# ─── SERVIDOR ────────────────────────────────────────────
PORT=5000
